# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
/build
next-env.d.ts

# production
*.tsbuildinfo

# turbopack
/.next-profiles/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets, .env.example is the tracked template
.env
.env.*
!.env.example

# drizzle
/drizzle/meta/_journal.json.bak

# os
.DS_Store
Thumbs.db

# editors
.vscode/*
!.vscode/extensions.json
.idea/

# k8s — 封をする前の平文。kubeseal に食わせるだけのもので、Git には入れない。
# 封をした k8s/sealed-secret.yaml は入れてよい（クラスタの鍵でしか開けない）。
k8s/secret.yaml

# misc
*.pem
# Sealed Secrets の公開証明書。公開鍵なので入れてよく、
# 入れておくとクラスタに繋がずに封をできる。
!k8s/cert.pem
k8s/secret.yaml

# podman machine ssh on Windows drops its known_hosts write here
NUL

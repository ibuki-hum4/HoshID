{
  "name": "hoshid",
  "version": "0.1.0",
  "private": true,
  "description": "HoshID — self-hosted OpenID Connect provider",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:up": "podman compose -f compose.dev.yaml up -d",
    "db:down": "podman compose -f compose.dev.yaml down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "auth:schema": "bunx auth@1.7.5 generate --config lib/auth.ts -y",
    "db:deploy": "prisma migrate deploy",
    "deploy:prepare": "prisma migrate deploy && bun run scripts/key-maintenance.ts",
    "rp": "bun run scripts/test-rp/index.ts",
    "e2e": "bun run scripts/e2e-authorization-code.ts",
    "verify:apply": "bun run scripts/verify-application-flow.ts",
    "seed:admin": "bun run scripts/seed-admin.ts",
    "seed:client": "bun run scripts/seed-client.ts",
    "mail:test": "bun run scripts/send-test-mail.ts",
    "licenses:generate": "bun run scripts/generate-licenses.ts",
    "jwks": "bun run scripts/rotate-jwks.ts",
    "keys:maintain": "bun run scripts/key-maintenance.ts",
    "secrets:reencrypt": "bun run scripts/reencrypt-secrets.ts",
    "verify:jwks": "bun run scripts/verify-jwks-roundtrip.ts",
    "verify:secrets": "bun run scripts/verify-secrets-readable.ts",
    "discord:sync": "bun run scripts/discord-sync.ts",
    "bot": "bun run bot/index.ts"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.5",
    "@better-auth/passkey": "1.7.5",
    "@discordjs/rest": "2.6.3",
    "@discordjs/ws": "2.0.4",
    "@hookform/resolvers": "5.9.1",
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@types/qrcode": "^1.5.6",
    "better-auth": "1.7.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "nodemailer": "10.0.10",
    "pg": "8.23.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-easy-crop": "6.2.3",
    "react-hook-form": "7.88.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^24",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.1",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.5",
    "openid-client": "6.8.8",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3"
  },
  "trustedDependencies": [
    "@node-rs/argon2",
    "@prisma/engines",
    "esbuild",
    "prisma",
    "sharp",
    "unrs-resolver"
  ]
}

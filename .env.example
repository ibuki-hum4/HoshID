# Copy to .env.local and fill in. Never commit the filled-in file.

# PostgreSQL. Matches the credentials in compose.dev.yaml for local development.
DATABASE_URL=postgres://hoshid:hoshid@localhost:5432/hoshid

# Root secret for Better Auth. Also derives the key that encrypts the private
# JWKS signing keys stored in the database — losing it invalidates every token
# HoshID has ever issued. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin of this instance. This value becomes the OIDC `issuer` and the
# `iss` claim of every ID token, so it must match exactly what relying parties
# are configured with — including scheme, host, port and absence of a trailing
# slash.
BETTER_AUTH_URL=http://localhost:3000

# --- メール送信（さくらのメールボックス / SMTP）---
# ホスト名とポートはさくらのコントロールパネルで確認すること。
# 初期ドメインを使う場合は <初期ドメイン>.sakura.ne.jp の形。
# SMTP_USER はメールアドレス全体（ユーザー名部分だけではない）。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false          # 587 = STARTTLS なので false。465 を使うなら true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="HoshID <noreply@example.jp>"

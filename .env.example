# Copy to .env.local and fill in. Never commit the filled-in file.

# PostgreSQL. Matches the credentials in compose.dev.yaml for local development.
DATABASE_URL=postgres://hoshid:hoshid@localhost:5432/hoshid

# Root secret for Better Auth. Derives the key that encrypts everything secret
# stored in the database: the private JWKS signing keys, the TOTP secrets and
# backup codes of every user with two-factor enabled, email OTPs, and OAuth
# state. Losing it locks those users out — replacing it naively does too.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Versioned secrets, for rotating the value above without breaking what is
# already encrypted. Comma-separated "<version>:<secret>", newest first; the
# first entry encrypts new writes, the rest stay readable. BETTER_AUTH_SECRET
# remains the fallback for ciphertext written before versioning started, so do
# not remove it until no unversioned ciphertext is left.
# See docs/key-rotation.md before touching this.
#   BETTER_AUTH_SECRETS=2:<newest>,1:<previous>
BETTER_AUTH_SECRETS=

# Public origin of this instance. This value becomes the OIDC `issuer` and the
# `iss` claim of every ID token, so it must match exactly what relying parties
# are configured with — including scheme, host, port and absence of a trailing
# slash.
BETTER_AUTH_URL=http://localhost:3000

# Addresses or CIDR ranges of the proxies in front of this app, comma separated.
# REQUIRED IN PRODUCTION when running behind an ingress or load balancer.
#
# Without it the client IP cannot be resolved from a multi-value
# X-Forwarded-For, and rate limiting degrades to a SINGLE SHARED BUCKET for all
# users — sign-in is capped at 3 requests per 10 seconds in total. The library
# only logs one warning, so this surfaces as "login fails sometimes".
#
# Use the proxy's own address or subnet (for k8s, the ingress controller's pod
# CIDR). Do NOT use a broad private range that also covers clients: anything
# inside it is trusted to declare who the client is.
#   TRUSTED_PROXIES=10.42.0.0/16
TRUSTED_PROXIES=

# --- 外部アカウントとの連携 ---
# Discord: 申請者の本人確認に使う。開発者ポータル → OAuth2 で作成し、
# リダイレクト URI に <BETTER_AUTH_URL>/api/link/discord/callback を登録する。
# 要求するスコープは identify だけ（メールもサーバ一覧も取得しない）。
# **Bot token ではない。** Bot token は「この申請者が本人である」ことの
# 証明にならない。
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# HoshID のアカウントを持つ人に、Discord のロールを付ける設定。
# **ロールの付与は OAuth のスコープではなく Bot の仕事。** 利用者から追加で
# 許可を取る必要はない（連携時の identify で得た ID だけで足りる）。
#
# Bot 側に必要なもの:
#   - 対象のサーバに参加していること
#   - MANAGE_ROLES 権限
#   - **付けたいロールより上の位置にいること**（これを満たさないと 403）
#
# 3つとも設定されたときだけ有効になる。ロールを持つのは active のアカウント
# だけで、停止・却下・削除・連携解除で外れる。
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_MEMBER_ROLE_ID=

# サーバに入っていない人に案内する招待リンク（任意）。
# ロールはサーバのメンバーにしか付かないので、参加していない人には連携画面と
# アカウント設定でその旨を出す。ここを設定すると、そこに導線が付く。
# **どのサーバに入っているかを利用者に尋ねる必要はない。** 見たいのは
# 「うちのサーバにいるか」だけで、それは Bot に問い合わせれば分かる。
# guilds スコープを足すと、その人の全サーバ一覧まで預かることになる。
DISCORD_GUILD_INVITE_URL=

# GitHub: プロフィール表示に使う。Settings → Developer settings → OAuth Apps。
# Authorization callback URL は <BETTER_AUTH_URL>/api/link/github/callback。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 草（contribution graph）の取得に使う読み取り専用トークン。
# classic PAT なら read:user を付けること。GitHub の GraphQL API は
# **スコープが1つも無いトークンも 401 で拒否する**。未設定なら草は表示されない。
# 連携時に得た利用者のトークンは保存していないため、サーバ側の値が要る。
#
# **名前が GITHUB_TOKEN ではないのは意図的。** あの名前は広く使われていて、
# シェルや OS の環境変数に残っていると .env より優先される（dotenv も Next.js も
# 既に process.env にある値を上書きしない）。GitHub Actions に至っては実行時に
# 自動で注入してくる。どちらも意図しないトークンで 401 になり、原因が
# 環境変数の衝突だとは気づけない。
GITHUB_CONTRIBUTIONS_TOKEN=

# --- メール送信（さくらのメールボックス / SMTP）---
# ホスト名とポートはさくらのコントロールパネルで確認すること。
# 初期ドメインを使う場合は <初期ドメイン>.sakura.ne.jp の形。
# SMTP_USER はメールアドレス全体（ユーザー名部分だけではない）。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false          # 587 = STARTTLS なので false。465 を使うなら true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="HoshID <noreply@example.jp>"

# --- 検証用（開発時のみ）---
# scripts/seed-client.ts が登録時に出力する値。client_secret はその時しか見られない。
HOSHID_CLIENT_ID=
HOSHID_CLIENT_SECRET=
# scripts/e2e-authorization-code.ts が使う、承認済みユーザーの資格情報。
E2E_EMAIL=
E2E_PASSWORD=
